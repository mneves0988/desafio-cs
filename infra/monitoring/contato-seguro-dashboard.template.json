            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 8,
        "width": 12,
        "height": 6,
        "widget": {
          "title": "Eventos recentes (amostra local do Docker)",
          "logsPanel": {
            "filter": "resource.type=\"global\" AND logName=\"projects/__PROJECT_ID__/logs/contato-seguro-ai-demo\"",
            "resourceNames": [
              "projects/__PROJECT_ID__"
            ]
          }
        }
      }
    ]
  }
